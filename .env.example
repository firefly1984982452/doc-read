# 小红书本地助手默认端口。与 docsify serve 的 3000 端口分开。
DOC_READ_XHS_PORT=3002

# Docsify 默认访问地址。只有从 file:// 打开网页时才会用到这个回退地址。
DOC_READ_SITE_ORIGIN=http://127.0.0.1:3000/

# 可选：修改小红书素材保存目录。
# DOC_READ_XHS_OUTPUT_ROOT=~/Downloads/小红书-待上传

# 可选：浏览器或 Codex 不在默认位置时手动指定。
# DOC_READ_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
